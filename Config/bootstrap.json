{
  "authentication":
  {
    "provider": "LocalFile",
    "usersFile": "Config/users.json"
  },

  "database":
  {
    "path": "Data/framework.db",
    "type": "SQLite"
  },

  "execution":
  {
    "engine": "Generic",
    "timeoutSeconds": 30
  },

  "framework":
  {
    "name": "Open Source LabVIEW Test Framework"
  },

  "logging":
  {
    "level": "Info"
  },

  "paths":
  {
    "logs": "Logs/",
    "packages": "Packages/",
    "plugins": "Plugins/",
    "shared": "Shared/"
  },

  "station":
  {
    "name": "Station01"
  }  
}